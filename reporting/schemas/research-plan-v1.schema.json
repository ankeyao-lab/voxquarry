{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/research-plan-v1.schema.json",
  "title": "VoxQuarry Research Plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "primary_direction",
    "analysis_modules",
    "factors",
    "scope",
    "comparison",
    "quality_gates",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "research-plan/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "primary_direction": {
      "type": "string",
      "enum": [
        "satisfaction-overview",
        "pain-and-failure",
        "product-attribute-performance",
        "needs-and-use-cases",
        "product-opportunity",
        "brand-product-comparison",
        "channel-comparison",
        "model-time-comparison",
        "user-profile",
        "smart-opportunity"
      ]
    },
    "analysis_modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "factors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "market_regions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["North America", "Europe", "Australia", "Other"]
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["minimum_n", "alpha", "effect_size"],
      "properties": {
        "minimum_n": {
          "type": "integer",
          "minimum": 2
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "effect_size": {
          "type": "boolean"
        }
      }
    },
    "quality_gates": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "string",
      "enum": [
        "satisfaction-overview",
        "pain-and-failure",
        "product-attribute-performance",
        "needs-and-use-cases",
        "product-opportunity",
        "brand-product-comparison",
        "channel-comparison",
        "model-time-comparison",
        "user-profile",
        "smart-opportunity"
      ]
    }
  },
  "additionalProperties": true
}
