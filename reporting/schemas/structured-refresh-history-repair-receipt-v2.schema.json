{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/structured-refresh-history-repair-receipt-v2.schema.json",
  "title": "VoxQuarry structured refresh history multi-repair receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_sha256",
    "original_history_sha256",
    "repaired_history_sha256",
    "original_bytes",
    "repaired_bytes",
    "repair_count",
    "repairs",
    "archive_path",
    "evidence_path",
    "live_history_verified",
    "live_history_sha256",
    "live_metadata",
    "audit_failures"
  ],
  "properties": {
    "schema_version": {
      "const": "voxquarry.structured-refresh-history-repair-receipt/v2"
    },
    "status": {
      "enum": ["dry_run", "prepared", "applied", "applied_with_audit_failure"]
    },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "original_history_sha256": { "$ref": "#/$defs/sha256" },
    "repaired_history_sha256": { "$ref": "#/$defs/sha256" },
    "original_bytes": { "type": "integer", "minimum": 0 },
    "repaired_bytes": { "type": "integer", "minimum": 0 },
    "repair_count": { "type": "integer", "minimum": 1 },
    "repairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repairAudit" }
    },
    "archive_path": { "type": ["string", "null"] },
    "evidence_path": { "type": ["string", "null"] },
    "live_history_verified": { "type": ["boolean", "null"] },
    "live_history_sha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "live_metadata": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "uid", "gid"],
          "properties": {
            "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
            "uid": { "type": "integer", "minimum": 0 },
            "gid": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "audit_failures": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema_version", "sha256", "payload"],
      "properties": {
        "kind": { "enum": ["readiness", "task", "event", "incident"] },
        "schema_version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "payload": { "type": "object" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reconstruction_policy",
        "batch_ids",
        "job_ids",
        "source_content_fingerprint",
        "readiness_record_sha256",
        "task_record_sha256",
        "event_record_sha256",
        "incident_record_sha256",
        "source_records"
      ],
      "properties": {
        "schema_version": {
          "const": "voxquarry.structured-refresh-history-repair-authority/v1"
        },
        "reconstruction_policy": {
          "enum": [
            "voxquarry.authoritative-failed-history-regeneration/v1",
            "voxquarry.authoritative-failed-history-quarantine/v1"
          ]
        },
        "batch_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^acq_[0-9a-f]{24}$" }
        },
        "job_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
        },
        "source_content_fingerprint": { "$ref": "#/$defs/sha256" },
        "readiness_record_sha256": { "$ref": "#/$defs/sha256" },
        "task_record_sha256": { "$ref": "#/$defs/sha256" },
        "event_record_sha256": { "$ref": "#/$defs/sha256" },
        "incident_record_sha256": { "$ref": "#/$defs/sha256" },
        "source_records": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/sourceRecord" }
        }
      }
    },
    "repairAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "disposition",
        "damaged_line_number",
        "damaged_line_sha256",
        "fragment_sha256",
        "suffix_event_sha256",
        "previous_line_sha256",
        "following_line_sha256",
        "incident_evidence_sha256",
        "replacement_event_sha256",
        "regenerated_event_sha256",
        "quarantine_record_sha256",
        "quarantine_reason",
        "quarantine_evidence_path",
        "quarantine_record_path",
        "authority"
      ],
      "oneOf": [
        {
          "properties": {
            "action": { "const": "regenerate_failed_event" },
            "disposition": { "const": "regenerated" },
            "regenerated_event_sha256": { "$ref": "#/$defs/sha256" },
            "quarantine_record_sha256": { "type": "null" },
            "quarantine_reason": { "type": "null" },
            "quarantine_evidence_path": { "type": "null" },
            "quarantine_record_path": { "type": "null" }
          }
        },
        {
          "properties": {
            "action": { "const": "quarantine_failed_fragment" },
            "disposition": { "const": "quarantined" },
            "regenerated_event_sha256": { "type": "null" },
            "quarantine_record_sha256": { "$ref": "#/$defs/sha256" },
            "quarantine_reason": {
              "enum": [
                "authoritative_event_unavailable",
                "authoritative_event_not_unique"
              ]
            }
          }
        }
      ],
      "properties": {
        "action": {
          "enum": ["regenerate_failed_event", "quarantine_failed_fragment"]
        },
        "disposition": { "enum": ["regenerated", "quarantined"] },
        "damaged_line_number": { "type": "integer", "minimum": 1 },
        "damaged_line_sha256": { "$ref": "#/$defs/sha256" },
        "fragment_sha256": { "$ref": "#/$defs/sha256" },
        "suffix_event_sha256": { "$ref": "#/$defs/sha256" },
        "previous_line_sha256": { "$ref": "#/$defs/nullableSha256" },
        "following_line_sha256": { "$ref": "#/$defs/nullableSha256" },
        "incident_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "replacement_event_sha256": { "$ref": "#/$defs/sha256" },
        "regenerated_event_sha256": { "$ref": "#/$defs/nullableSha256" },
        "quarantine_record_sha256": { "$ref": "#/$defs/nullableSha256" },
        "quarantine_reason": {
          "type": ["string", "null"],
          "enum": [
            "authoritative_event_unavailable",
            "authoritative_event_not_unique",
            null
          ]
        },
        "quarantine_evidence_path": { "type": ["string", "null"] },
        "quarantine_record_path": { "type": ["string", "null"] },
        "authority": { "$ref": "#/$defs/authority" }
      }
    }
  }
}
