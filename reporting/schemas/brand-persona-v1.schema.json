{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/brand-persona-v1.schema.json",
  "title": "VoxQuarry Brand Persona Workbench v1",
  "type": "object",
  "required": ["schema_version", "method_version", "snapshot_id", "analysis_id", "content_hash", "scope", "sample", "sample_composition", "dimensions", "claim_pool", "personas", "quality", "persona_narrative"],
  "properties": {
    "schema_version": {"const": "brand-persona-workbench/v1"},
    "method_version": {"type": "string"},
    "snapshot_id": {"type": "string", "minLength": 1},
    "analysis_id": {"type": "string", "pattern": "^bpa_[0-9a-f]{24}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {
      "type": "object",
      "required": ["brand", "category_ids", "models", "channels", "market_regions", "job_ids", "date_range"],
      "properties": {
        "brand": {"type": "string", "minLength": 1},
        "category_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "models": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "market_regions": {"type": "array", "items": {"enum": ["North America", "Europe", "Australia", "Other"]}, "uniqueItems": true},
        "job_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "date_range": {"type": "object"}
      },
      "additionalProperties": false
    },
    "sample": {"type": "object"},
    "sample_composition": {"type": "object"},
    "dimensions": {"type": "array", "items": {"type": "object"}},
    "claim_pool": {"type": "array", "items": {"type": "object"}},
    "personas": {"type": "array", "items": {"type": "object"}},
    "task_context": {"type": "array", "items": {"type": "object"}},
    "quality": {"type": "object"},
    "persona_narrative": {
      "type": "object",
      "required": ["status", "schema_version", "policy_version", "llm_used"],
      "properties": {
        "status": {"enum": ["deterministic_fallback", "qwen_validated"]},
        "schema_version": {"const": "brand-persona-narrative/v1"},
        "policy_version": {"const": "persona-claim-lock/1.0.0"},
        "llm_used": {"type": "boolean"},
        "model": {"type": ["string", "null"]}
      }
    }
  }
}
