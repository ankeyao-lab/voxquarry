{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/zhuojian.aggregate_report_reviews-v1.schema.json",
  "title": "zhuojian.aggregate_report_reviews@v1 input",
  "type": "object",
  "required": [
    "report_id"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^rpt_[A-Za-z0-9_-]{8,80}$"
    },
    "review_ids": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "pattern": "^(occ|rev)_[A-Za-z0-9_-]{1,128}$"
      }
    },
    "query": {
      "type": "string",
      "maxLength": 500,
      "description": "Case-insensitive literal text in full normalized title or body, using match_mode; matches do not establish sentiment or semantic absence."
    },
    "match_mode": {
      "enum": ["substring", "word"],
      "default": "substring",
      "description": "Applies to query, term_groups and exclude_terms. substring preserves existing behavior. word matches escaped literal words/phrases bounded by Unicode letters, digits or underscores; turn does not match return or turning, with no stemming. Terms containing Han characters and no whitespace retain substring matching. Phrase whitespace is literal; no arbitrary regex or SQL."
    },
    "filters": {
      "type": "object",
      "properties": {
        "ratings": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "has_text": {
          "type": "boolean"
        },
        "channels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "brands": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "models": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "date_start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    },
    "population": {
      "enum": [
        "entities",
        "occurrences"
      ],
      "default": "entities"
    },
    "term_groups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "label",
          "terms"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "terms": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      },
      "description": "Within each group OR; across groups AND. Group counts cover the full base-filtered population."
    },
    "exclude_terms": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "group_by": {
      "enum": [
        "rating",
        "channel",
        "brand",
        "model",
        "submission_month",
        "has_text"
      ],
      "default": "rating"
    }
  },
  "additionalProperties": false
}
