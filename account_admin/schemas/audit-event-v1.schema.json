{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/audit-event-v1.schema.json",
  "title": "VoxQuarry audit event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "occurred_at",
    "actor_principal_id",
    "actor_employee_id",
    "actor_display_name",
    "actor_roles",
    "session_id",
    "request_id",
    "correlation_id",
    "module",
    "action",
    "resource_type",
    "resource_id",
    "result",
    "reason_code",
    "client_ip",
    "user_agent",
    "policy_version",
    "changes",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "audit-event/v1"},
    "event_id": {"type": "string", "pattern": "^aud_[a-f0-9]{32}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor_principal_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "actor_employee_id": {"type": "string", "maxLength": 128},
    "actor_display_name": {"type": "string", "maxLength": 160},
    "actor_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "session_id": {"type": ["string", "null"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "module": {"type": "string", "minLength": 1, "maxLength": 80},
    "action": {"type": "string", "minLength": 1, "maxLength": 120},
    "resource_type": {"type": "string", "minLength": 1, "maxLength": 120},
    "resource_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "result": {"enum": ["success", "denied", "failure"]},
    "reason_code": {"type": "string", "minLength": 1, "maxLength": 120},
    "client_ip": {"type": "string", "maxLength": 64},
    "user_agent": {"type": "string", "maxLength": 256},
    "policy_version": {"const": "account-admin-local-dev/1.1.0"},
    "changes": {"type": "object"},
    "metadata": {"type": "object"}
  }
}
