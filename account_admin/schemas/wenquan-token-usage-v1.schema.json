{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxquarry.local/schemas/wenquan-token-usage-v1.schema.json",
  "title": "Wenquan token usage attribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "usage_event_id",
    "principal_id",
    "session_id",
    "request_id",
    "model",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {"const": "wenquan-token-usage/v1"},
    "usage_event_id": {"type": "string", "pattern": "^usage_[a-f0-9]{32}$"},
    "principal_id": {"type": "string", "pattern": "^prn_[a-z0-9_]{6,80}$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "minLength": 1, "maxLength": 160},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
