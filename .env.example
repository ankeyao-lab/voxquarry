# Optional shell configuration: set values, then: set -a; . ./.env; set +a
# Model-free imports, products and reports work without these variables.
VOXQUARRY_DATA_DIR=.runtime
VOXQUARRY_ORIGIN=http://127.0.0.1:18763
VOXQUARRY_INTERNAL_URL=http://127.0.0.1:18763
# Set all three together to enable AI research. Never commit a real key.
VOXQUARRY_LLM_API_KEY=
VOXQUARRY_LLM_BASE_URL=
VOXQUARRY_LLM_MODEL=
# Optional provider-specific reasoning configuration. Generic requests omit
# enable_thinking; it is sent only to compatible named provider families.
# VOXQUARRY_LLM_REASONING_EFFORT=low
# VOXQUARRY_WENQUAN_HARNESS_ENABLED=false
